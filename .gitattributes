# Normalize all text files to LF in the repo and on checkout.
# This prevents CRLF warnings on Windows and ensures consistent
# line endings across all platforms (Windows, macOS, Linux).
*       text=auto eol=lf

# Explicitly mark common text file types
*.py    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.toml  text eol=lf
*.sh    text eol=lf

# Binary files — do not modify
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary

# ---------------------------------------------------------------------------
# Generated outputs. GitHub linguist hides these from language stats and
# marks them as generated in diffs. Existing text/eol rules above still apply.
#
# doc/source/*.md is mixed: pipeline source pages are generated, but legacy
# source pages and doc/source/ics.md, static.md and multiple.md are
# hand-written. Those generated pages are enforced by
# tools/check_generated_files.py rather than a blanket linguist pattern.
# translations/*.json are only partly generated (config.step.args_*); they are
# marked for linguist but not hard-blocked by the PR guard (options.step.init
# and translation_templates/ are hand-maintained).
# ---------------------------------------------------------------------------
README.md linguist-generated=true
info.md linguist-generated=true
doc/ics/*.md linguist-generated=true
custom_components/waste_collection_schedule/sources.json linguist-generated=true
custom_components/waste_collection_schedule/source_metadata.json linguist-generated=true
custom_components/waste_collection_schedule/translations/*.json linguist-generated=true
.github/source_owners.json linguist-generated=true
custom_components/waste_collection_schedule/frontend/waste-collection-cards.js linguist-generated=true
custom_components/waste_collection_schedule/frontend/THIRD-PARTY-NOTICES.txt linguist-generated=true

